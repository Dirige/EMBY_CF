{
  "name": "emby-cf-refactor",
  "version": "0.1.0-local",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:workers": "node scripts/package-workers.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:multi:snapshot": "node scripts/accept-multi-snapshot.mjs",
    "bench": "node scripts/bench.mjs",
    "wallpaper:cache": "node scripts/cache-wallpaper.mjs",
    "check": "npm run package:workers && npm run docs:build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "marked": "18.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "miniflare": {
      "workerd": "1.20261124.1",
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  }
}
